# LLM provider. "fake" needs no key and is the default - the whole course runs on it.
# Set to "openai" plus LLM_API_KEY to use a real OpenAI-compatible endpoint (OpenAI
# itself, or a local server like Ollama/LM Studio in OpenAI-compatible mode).
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Loopline sample database. SQLite by default; point at MySQL from Episode 15 onward,
# e.g. mysql+pymysql://user:password@localhost:3306/loopline
LOOPLINE_DATABASE_URL=sqlite:///./sample_app/loopline/loopline.db

# Read-only allowlisted roots for the copilot's source/docs/log tools (Episode 5)
LOOPLINE_SOURCE_ROOT=./sample_app/loopline/app
LOOPLINE_DOCS_ROOT=./sample_app/loopline/docs
LOOPLINE_LOGS_ROOT=./sample_app/loopline/logs
