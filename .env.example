# LLM provider. "fake" needs no key and is the default - the whole course runs on it.
# Set to "openai" plus LLM_API_KEY to use a real OpenAI-compatible endpoint (OpenAI
# itself, or a local server like Ollama/LM Studio in OpenAI-compatible mode).
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Loopline sample database. SQLite by default; point at MySQL from Episode 16 onward,
# e.g. mysql+pymysql://user:password@127.0.0.1:3306/loopline - use 127.0.0.1, not
# localhost: on at least one Windows + Docker Desktop setup, "localhost" resolved to
# an IPv6 address nothing was listening on first, adding a real ~5s connect delay
# before falling back to IPv4. 127.0.0.1 skips that resolution step entirely.
LOOPLINE_DATABASE_URL=sqlite:///./sample_app/loopline/loopline.db

# Read-only allowlisted roots for the copilot's source/docs/log tools (Episode 5)
LOOPLINE_SOURCE_ROOT=./sample_app/loopline/app
LOOPLINE_DOCS_ROOT=./sample_app/loopline/docs
LOOPLINE_LOGS_ROOT=./sample_app/loopline/logs

# query_database's OWN connection (Episode 16) - deliberately separate from
# LOOPLINE_DATABASE_URL above, which is Loopline the app's own read-write database.
# Leave blank to keep query_database on SQLite (the default, no Docker required).
# To switch to MySQL: `docker compose up -d`, set MYSQL_ROOT_PASSWORD and
# MYSQL_READER_PASSWORD below (used by docker-compose.yml and
# sample_app/loopline/mysql-readonly-user.sh to provision a read-only
# loopline_reader user - MySQL's own privilege system enforces "read-only" for this
# path, the same way SQLite's ?mode=ro connection does for the default one), then set:
# LOOPLINE_READONLY_DATABASE_URL=mysql+pymysql://loopline_reader:<MYSQL_READER_PASSWORD>@127.0.0.1:3306/loopline
LOOPLINE_READONLY_DATABASE_URL=

# Route query_database through a standalone MCP server (mcp_server/server.py)
# instead of connecting to MySQL in-process. Only has any effect once
# LOOPLINE_READONLY_DATABASE_URL above is set to a mysql+pymysql:// URL - the MCP
# server is spawned automatically per call, nothing separate to start yourself.
USE_DATABASE_MCP=false

# Only read by docker-compose.yml and sample_app/loopline/mysql-readonly-user.sh,
# never by the copilot itself - pick any local values, these never leave your machine.
MYSQL_ROOT_PASSWORD=
MYSQL_READER_PASSWORD=
